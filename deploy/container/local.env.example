# Copy to repository root as .env, then fill locally. Never commit passwords.
ACCEPT_SQLTOOLS_EULA=N
INSTALL_RIG_TRAINING=true
# Docker Desktop reaches the laptop through host.docker.internal, not localhost.
# SQL Server needs a fixed TCP port and a dedicated SQL Authentication login.
SQL_SERVER=tcp:host.docker.internal,1433
SQL_USER=
SQL_PASSWORD=
OLLAMA_BASE_URL=http://host.docker.internal:11434
