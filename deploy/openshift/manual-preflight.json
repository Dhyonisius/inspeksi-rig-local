{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "inspeksi-rig-ubuntu-deploy-preflight"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 600,
    "template": {
      "metadata": {
        "labels": {
          "app": "inspeksi-rig-ubuntu-deploy-preflight"
        }
      },
      "spec": {
        "nodeSelector": {
          "kubernetes.io/os": "linux",
          "kubernetes.io/arch": "amd64"
        },
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "initContainers": [
          {
            "name": "prepare-storage",
            "image": "REPLACE_WITH_IMAGE_AT_SHA256",
            "command": [
              "node",
              "-e",
              "const fs=require('fs');for(const p of ['data/private','models'])fs.mkdirSync('/storage/'+p,{recursive:true});"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "200m",
                "memory": "128Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "storage",
                "mountPath": "/storage"
              },
              {
                "name": "temporary",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "storage",
            "persistentVolumeClaim": {
              "claimName": "inspeksi-rig-ubuntu-deploy-storage"
            }
          },
          {
            "name": "temporary",
            "emptyDir": {
              "sizeLimit": "1Gi"
            }
          }
        ],
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "check",
            "image": "REPLACE_WITH_IMAGE_AT_SHA256",
            "command": [
              "node",
              "scripts/openshift-preflight.mjs",
              "--services",
              "--training"
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "inspeksi-rig-ubuntu-deploy-config"
                }
              },
              {
                "secretRef": {
                  "name": "inspeksi-rig-ubuntu-deploy-sql"
                }
              }
            ],
            "env": [
              {
                "name": "SQL_MIGRATE_ON_START",
                "value": "false"
              },
              {
                "name": "SQL_ENCRYPT",
                "value": "mandatory"
              },
              {
                "name": "SQL_TRUST_SERVER_CERTIFICATE",
                "value": "false"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "2",
                "memory": "2Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "storage",
                "mountPath": "/app/data",
                "subPath": "data"
              },
              {
                "name": "storage",
                "mountPath": "/app/models",
                "subPath": "models"
              },
              {
                "name": "temporary",
                "mountPath": "/tmp"
              }
            ]
          }
        ]
      }
    }
  }
}
